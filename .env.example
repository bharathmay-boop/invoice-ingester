# Variable names only. Real values live in .env.local, which is gitignored,
# and in the Vercel project. Never commit a value to this file.

# Pulled from Vercel with `vercel env pull`
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=

# Set once per project, not pulled from anywhere
# 32 bytes of base64. API keys are sealed with it, so losing it means
# re-entering the keys, not losing invoice data.
SETTINGS_MASTER_KEY=
# The single password that gates every write.
ADMIN_PASSWORD=

# Local only. Read when VERCEL is unset, which is never true on a deployment.
# Lets a provider key be tested without saving it into the shared database.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
